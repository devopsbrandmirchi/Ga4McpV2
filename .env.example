# Public origin of this app, no trailing slash.
# Local: http://localhost:3000
# Cloud Run: https://ga4-mcp-v2-xxxxxxxxxx-uc.a.run.app
APP_BASE_URL=http://localhost:3000

# V2 Google OAuth web client (separate from V1).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a redirect URI on the V2 Google OAuth client.
# Defaults to ${APP_BASE_URL}/oauth/google/callback if omitted.
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Required. Signs MCP authorization codes and access/refresh tokens.
MCP_TOKEN_SECRET=

# Required. Signs Google OAuth state and encrypts pending-authorize cookies.
OAUTH_STATE_SECRET=

# Required. 32-byte key used to encrypt Google refresh tokens at rest.
# 64 hex characters, or any long random string (hashed to 32 bytes).
TOKEN_ENCRYPTION_KEY=

# Firestore project. On Cloud Run this can match the runtime project.
# Locally, set this and optionally FIRESTORE_EMULATOR_HOST.
FIRESTORE_PROJECT_ID=

# Local/test only. Example: localhost:8080
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Optional. Only if you paste a confidential client into Claude.ai
# Custom Connector Advanced Settings.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
